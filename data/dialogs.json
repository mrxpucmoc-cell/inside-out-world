{
  "helga": {
    "start": "greet",
    "nodes": {
      "greet": {
        "speaker": "Хельга",
        "text": "Подойди ближе, Пустой. Слушаю тебя.",
        "dynamicOptions": "questsFor:helga",
        "fallback": { "text": "Позже", "action": "close" },
        "options": [
          { "text": "Почему все зовут меня Пустым?", "next": "why_empty" }
        ]
      },
      "why_empty": {
        "speaker": "Хельга",
        "text": "Ты пришёл без прошлого. Кувшин без воды. Сюда можно налить что угодно: доблесть, яд, чужую волю. Поэтому вас и боятся.",
        "options": [{ "text": "Понял", "next": "greet" }]
      }
    }
  },

  "iva": {
    "start": "greet",
    "nodes": {
      "greet": {
        "speaker": "Ива",
        "text": "Очнулся! Слава тёмным водам. Что тебе нужно?",
        "dynamicOptions": "questsFor:iva",
        "fallback": { "text": "Позже", "action": "close" },
        "options": [
          { "text": "Что это за место?", "next": "where" },
          { "text": "Ничего не помню.", "next": "no_mem" }
        ]
      },
      "where": {
        "speaker": "Ива",
        "text": "Побережье Костей. Здесь вода выносит то, что потеряли другие. Иногда — людей.",
        "onEnter": [{ "action": "setFlag", "flag": "metIva", "value": true }],
        "options": [{ "text": "Понял", "next": "greet" }]
      },
      "no_mem": {
        "speaker": "Ива",
        "text": "Ничего — это лучше, чем что-то страшное. Так говорит Хельга. Тебе нужно к ней.",
        "onEnter": [{ "action": "setFlag", "flag": "metIva", "value": true }],
        "options": [{ "text": "Понял", "next": "greet" }]
      }
    }
  },

  "yasen": {
    "start": "greet",
    "nodes": {
      "greet": {
        "speaker": "Ясень",
        "text": "Ну, чего встал? Двигаешься как боец — значит, будем учиться.",
